{
  "name": "@ihopenre-eng/point-annotation-toolbar",
  "version": "0.4.0",
  "description": "Windows 화면 주석 도구 — 투명 오버레이에서 펜·형광펜·레이저·지우개를 쓰는 Electron 데스크톱 앱",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihopenre-eng/online-study-tool-.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "desktop:renderer": "vite build --config desktop/vite.config.ts",
    "desktop:stage": "node scripts/stage-desktop.mjs",
    "desktop:start": "npm run desktop:renderer && electron .",
    "build:win": "npm run desktop:renderer && npm run desktop:stage && electron-builder --projectDir desktop-app --win portable --x64"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.point.annotation",
    "productName": "Point",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "desktop-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Point-${version}-portable.${ext}"
    }
  }
}
